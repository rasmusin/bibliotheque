<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" fx:controller="com.bibliotheque.controller.EmpruntController" spacing="8.0" padding="10.0">
    <HBox spacing="8.0">
        <TextField fx:id="rechercheEmpruntField" promptText="Rechercher par membre ou livre..." />
        <Button fx:id="btnRechercherEmprunt" text="Rechercher" onAction="#handleRechercherEmprunt" />
        <Button fx:id="btnTousLesEmprunts" text="Tous" onAction="#chargerTousLesEmprunts" />
        <ToggleButton fx:id="toggleEnCours" text="En cours" onAction="#filterEnCours" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnNouvelEmprunt" text="Nouvel Emprunt" onAction="#handleNouvelEmprunt" />
        <Button fx:id="btnModifierEmprunt" text="Modifier" onAction="#handleModifierEmprunt" />
        <Button fx:id="btnRetourEmprunt" text="Retour" onAction="#handleRetourEmprunt" />
        <Button fx:id="btnSupprimerEmprunt" text="Supprimer" onAction="#handleSupprimerEmprunt" />
    </HBox>

    <TableView fx:id="empruntsTable" prefHeight="420.0">
        <columns>
            <TableColumn fx:id="idEmpruntColumn" text="ID" />
            <TableColumn fx:id="livreEmpruntColumn" text="Livre" />
            <TableColumn fx:id="membreEmpruntColumn" text="Membre" />
            <TableColumn fx:id="dateEmpruntColumn" text="Date emprunt" />
            <TableColumn fx:id="dateRetourPrevueColumn" text="Retour prévu" />
            <TableColumn fx:id="dateRetourEffectifColumn" text="Retour effectif" />
            <TableColumn fx:id="penaliteColumn" text="Pénalité" />
        </columns>
    </TableView>

    <HBox spacing="12.0">
        <Label fx:id="lblTotalEmprunts" text="Total: 0" />
        <Label fx:id="lblEmpruntsEnCours" text="En cours: 0" />
        <Label fx:id="lblEmpruntsTerminés" text="Terminés: 0" />
    </HBox>
</VBox>
